# ================================================
# Book-2in1 — Root .gitignore
# Covers: React/TypeScript (rebook/) + Android Kotlin (RebookAndroid/)
# ================================================

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ── Editor & IDE ──────────────────────────────────────────────────────────────
.idea/
*.iml
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vscode/

# ════════════════════════════════════════════════
# React / Node (rebook/)
# ════════════════════════════════════════════════
node_modules/
dist/
.cache/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# dotenv
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# TypeScript
*.tsbuildinfo

# ════════════════════════════════════════════════
# Android / Kotlin (RebookAndroid/)
# ════════════════════════════════════════════════

# Gradle
.gradle/
build/
**/build/
local.properties

# Generated files
gen/
out/
captures/

# App artifacts
*.apk
*.aar
*.aab
*.ap_
*.dex
*.class

# Keystore & secrets — NEVER commit these
*.jks
*.keystore
google-services.json
*.p12

# Native build
.externalNativeBuild/
.cxx/

# Kotlin incremental build cache
.kotlin/

# ProGuard
proguard/

# fastlane
fastlane/report.xml
fastlane/screenshots
fastlane/test_output
